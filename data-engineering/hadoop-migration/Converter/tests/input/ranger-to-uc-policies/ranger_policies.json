      "isEnabled": true,
      "isAuditEnabled": true,
      "policyType": 1,
      "resources": {
        "database": {
          "values": ["retail_analytics"],
          "isRecursive": false,
          "isExcludes": false
        },
        "table": {
          "values": ["dim_customers"],
          "isRecursive": false,
          "isExcludes": false
        },
        "column": {
          "values": ["email", "phone", "first_name", "last_name"],
          "isRecursive": false,
          "isExcludes": false
        }
      },
      "dataMaskPolicyItems": [
        {
          "dataMaskInfo": {
            "dataMaskType": "MASK_HASH"
          },
          "accesses": [
            {"type": "select", "isAllowed": true}
          ],
          "users": [],
          "groups": ["data_analysts"],
          "delegateAdmin": false
        }
      ]
    },
    {
