{
  "serviceName": "retail_hive",
  "serviceType": "hive",
  "policies": [
    {
      "id": 1,
      "name": "data_engineering_full_access",
      "description": "Full access to all databases for the data engineering team",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "database": {
          "values": ["retail_analytics", "staging", "raw_data"],
          "isRecursive": false,
          "isExcludes": false
        },
        "table": {
          "values": ["*"],
          "isRecursive": false,
          "isExcludes": false
        },
        "column": {
          "values": ["*"],
          "isRecursive": false,
          "isExcludes": false
        }
      },
      "policyItems": [
        {
          "accesses": [
            {"type": "select", "isAllowed": true},
            {"type": "update", "isAllowed": true},
            {"type": "create", "isAllowed": true},
            {"type": "drop", "isAllowed": true},
            {"type": "alter", "isAllowed": true},
            {"type": "index", "isAllowed": true},
            {"type": "lock", "isAllowed": true},
            {"type": "all", "isAllowed": true}
          ],
          "users": ["etl_service_account"],
          "groups": ["data_engineering"],
          "delegateAdmin": true
        }
      ]
    },
    {
      "id": 2,
      "name": "analyst_read_access",
      "description": "Read-only access for analysts to production tables",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "database": {
          "values": ["retail_analytics"],
          "isRecursive": false,
          "isExcludes": false
        },
        "table": {
          "values": ["dim_customers", "fact_orders", "product_catalog", "vw_active_customers"],
          "isRecursive": false,
          "isExcludes": false
        },
        "column": {
          "values": ["*"],
          "isRecursive": false,
          "isExcludes": false
        }
      },
      "policyItems": [
        {
          "accesses": [
            {"type": "select", "isAllowed": true}
          ],
          "users": [],
          "groups": ["data_analysts", "business_analysts"],
          "delegateAdmin": false
        }
      ]
    },
    {
      "id": 3,
      "name": "pii_column_masking",
