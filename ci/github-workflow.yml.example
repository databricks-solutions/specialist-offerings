name: ci

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * *"      # nightly integration

jobs:
  unit:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: pip install -e '.[dev]'
      - run: ruff check src tests scripts
      - run: python scripts/lint_no_v1_overwrite.py src
      - run: python -m pytest -q tests/unit
      - run: bash scripts/scan_secrets.sh .
      - run: python -m build && ls dist/

  integration:
    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -e '.[dev,spark]'
      # exit code 5 = no tests collected (the suite is not populated yet)
      - run: python -m pytest -q -m integration tests/integration || test $? -eq 5
